# Copy this file to .env and fill in your values

# Anthropic Claude API key
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail OAuth credentials file path (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=credentials.json

# Gmail token file (auto-created after first OAuth login)
GMAIL_TOKEN_PATH=token.json

# How many days back to scan emails on each sync
EMAIL_LOOKBACK_DAYS=90

# Comma-separated keywords to identify credit card statement emails
CREDIT_CARD_KEYWORDS=statement,credit card,card statement

# Comma-separated keywords to identify bank statement emails
BANK_KEYWORDS=bank statement,account statement,transaction summary
